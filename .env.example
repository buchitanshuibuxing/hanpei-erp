# 复制为 .env 后按现场修改；生产由 deploy/install.sh 自动生成随机值
DATABASE_URL=sqlite:///./data/erp.db
# PostgreSQL 生产示例：
# DATABASE_URL=postgresql+psycopg://erp:CHANGE_ME@postgres:5432/erp
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
APP_ENV=development
APP_PORT=8008
# 加密 settings 中敏感键的主密钥（Fernet base64 32 字节）；留空时首次启动自动生成到 data/master.key
MASTER_KEY=
# 单端口：后端直接托管前端 dist/
SERVE_FRONTEND=1
# 默认管理员（仅首次初始化生效）
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_PASSWORD=admin123
